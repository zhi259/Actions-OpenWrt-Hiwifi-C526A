@@ -22,6 +22,14 @@ case "$FIRMWARE" in
  		ath10k_caldata_extract "art" "0x1000" "0x844"
  		;;
  	*)
+	hiwifi,c526a)
+		ath10k_caldata_extract "art" "0x1000" "0x844"
+		;;
+	*)
+		;;
+	esac
+	;;
+	*)
  		;;
  	esac
  	;;
diff --git a/target/linux/ipq40xx/base-files/etc/hotplug.d/ieee80211/10_fix_wifi_mac b/target/linux/ipq40xx/base-files/etc/hotplug.d/ieee80211/10_fix_wifi_mac
new file mode 100644
index 0000000000..5e2a5c4e5b
--- /dev/null
+++ b/target/linux/ipq40xx/base-files/etc/hotplug.d/ieee80211/10_fix_wifi_mac
@@ -0,0 +1,21 @@
+#!/bin/sh
+
+[ "$ACTION" = "add" ] || exit 0
+
+case "$DEVPATH" in
+*/*/*/net/*)
+	[ -e "/sys/$DEVPATH/address" ] || exit 0
+	;;
+*)	exit 0 ;;
+esac
+
+case "$(board_name)" in
+hiwifi,c526a)
+	# fix mac address for 5G wifi
+	mac=$(mtd_get_mac_text "factory" 0x1006)
+	[ -n "$mac" ] && ip link set dev "$INTERFACE" address "$mac"
+	;;
+*)	;;
+esac
+
+exit 0
diff --git a/target/linux/ipq40xx/base-files/etc/init.d/mt7615_reboot b/target/linux/ipq40xx/base-files/etc/init.d/mt7615_reboot
new file mode 100644
index 0000000000..a2b3c4d5e6
--- /dev/null
+++ b/target/linux/ipq40xx/base-files/etc/init.d/mt7615_reboot
@@ -0,0 +1,13 @@
+#!/bin/sh /etc/rc.common
+
+START=99
+
+start() {
+	# workaround for mt7615 reboot issue
+	[ -e /sys/kernel/debug/ieee80211/phy1/mt76 ] && {
+		echo 1 > /sys/kernel/debug/ieee80211/phy1/mt76/reboot
+	}
+}
+
+boot() { start; }
+shutdown() { start; }
diff --git a/target/linux/ipq40xx/base-files/lib/upgrade/platform.sh b/target/linux/ipq40xx/base-files/lib/upgrade/platform.sh
